# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
VITE_API_URL=/api
JWT_SECRET=replace-with-a-random-value-at-least-32-bytes
DEMO_MODE_ENABLED=true

# Optional configured workspace user: bcrypt hash (never store a plaintext password)
DEMO_EMAIL=merchant@example.com
DEMO_PASSWORD_HASH=replace-with-bcrypt-hash

# PayPal Reporting API server credentials (not exposed to the browser)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_APPROVED=false
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_ATTRIBUTION_ID=
PAYPAL_ONBOARDING_RETURN_URL=https://your-api.example.com/api/paypal/connect/return
PAYPAL_WEBHOOK_ID=
DATABASE_URL=
DATABASE_SSL=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:3000

# Optional Python ML service endpoint when connecting it through a deployment gateway
ML_ENGINE_URL=http://127.0.0.1:8001
