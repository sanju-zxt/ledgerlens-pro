# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
VITE_API_URL=/api
JWT_SECRET=replace-with-a-random-value-at-least-32-bytes

# Optional configured workspace user: bcrypt hash (never store a plaintext password)
DEMO_EMAIL=merchant@example.com
DEMO_PASSWORD_HASH=replace-with-bcrypt-hash

# PayPal Reporting API server credentials (not exposed to the browser)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional Python ML service endpoint when connecting it through a deployment gateway
ML_ENGINE_URL=http://127.0.0.1:8001
