{
  "name": "ledgerlens-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "ml-engine"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:ml": "npm run dev --workspace=ledgerlens-ml",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:ml\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run quality:report && npm run build --workspace=client",
    "test": "node scripts/run-tests-and-report.mjs",
    "validate": "powershell -File validate.ps1",
    "manifest": "node generate-manifest.cjs",
    "quality:report": "npm run quality:benchmark && node scripts/generate-quality-scorecard.mjs",
    "quality:benchmark": "python ml-engine/synthetic_benchmark.py",
    "paypal:verify:sandbox": "node scripts/verify-paypal-sandbox.mjs",
    "test:server": "node --test server/src/services/*.test.js server/src/routes.test.js",
    "test:ml": "npm run test --workspace=ledgerlens-ml",
    "test:evidence": "python -m unittest test_evidence.py"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
